# Секретный ключ Django. Обязательная переменная.
# Сгенерируйте значение командой:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=YOUR_SUPER_SECRET_KEY

# Параметры базы данных PostgreSQL.
# Используются сервисом db в compose.yaml для создания базы
# и Django для подключения к ней (см. config/settings.py).
DB_NAME=senio_db
DB_USER=senio_user
DB_PASSWORD=change_me_in_local_env